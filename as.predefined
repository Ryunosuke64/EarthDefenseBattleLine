// ========================
// string
// ========================
class string
{
    uint length() const;
    void resize(uint size);
    bool isEmpty() const;

    string substr(uint start = 0, int count = -1) const;

    int findFirst(const string&in str, uint start = 0) const;
    int findFirstOf(const string&in str, uint start = 0) const;
    int findFirstNotOf(const string&in str, uint start = 0) const;

    int findLast(const string&in str, int start = -1) const;
    int findLastOf(const string&in str, int start = -1) const;
    int findLastNotOf(const string&in str, int start = -1) const;

    void insert(uint pos, const string&in str);
    void erase(uint pos, int count = -1);
}